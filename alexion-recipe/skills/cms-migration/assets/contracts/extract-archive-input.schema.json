{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "archivePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "rootMarkers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "uniqueItems": true
    },
    "rootPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    }
  },
  "required": [
    "archivePath"
  ],
  "additionalProperties": false
}
