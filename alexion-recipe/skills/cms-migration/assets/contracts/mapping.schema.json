{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "entityId": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "taskId": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "routeIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "uniqueItems": true
    }
  },
  "required": [
    "entityId",
    "taskId"
  ],
  "additionalProperties": false
}
