{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "path": { "type": "string", "minLength": 1, "pattern": "\\S" },
      "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
    },
    "required": ["path", "sha256"],
    "additionalProperties": false
  }
}
