{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "compositionInput",
        "previewInput",
        "reviewInput",
        "applicationInput",
        "applicationPlan",
        "checkpoint",
        "applicationAuditInput",
        "phaseDecision",
        "websiteVerificationInput"
      ]
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "role",
    "path",
    "sha256"
  ],
  "additionalProperties": false
}
