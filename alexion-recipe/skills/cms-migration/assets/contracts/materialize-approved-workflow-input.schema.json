{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": { "const": 1 },
    "proposal": { "$ref": "file-fingerprint.schema.json" },
    "activeWorkflow": { "$ref": "file-fingerprint.schema.json" },
    "planningTaskId": { "type": "string", "minLength": 1, "pattern": "\\S" }
  },
  "required": ["version", "proposal", "activeWorkflow", "planningTaskId"],
  "additionalProperties": false
}
