{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "phaseId": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "anchorTaskId": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "prefix": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "agent": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "required": [
          "kind",
          "phaseId",
          "anchorTaskId",
          "prefix"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "rules"
  ],
  "additionalProperties": false
}
