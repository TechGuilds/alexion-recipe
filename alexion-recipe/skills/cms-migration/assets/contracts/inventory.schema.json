{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "scopeId": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "kind": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "source": {
            "type": "object",
            "properties": {
              "identity": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            },
            "required": [
              "identity",
              "path"
            ],
            "additionalProperties": false
          },
          "scope": {
            "enum": [
              "included",
              "excluded",
              "uncertain"
            ]
          },
          "parentIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "uniqueItems": true
          },
          "routeIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "uniqueItems": true
          },
          "joins": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "uniqueItems": true
          },
          "uncertainty": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "kind",
          "source",
          "scope",
          "parentIds",
          "routeIds",
          "joins",
          "uncertainty"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "scopeId",
    "entities"
  ],
  "additionalProperties": false
}
