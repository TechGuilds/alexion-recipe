{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "sourceDir": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "scopeId": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    }
  },
  "required": [
    "sourceDir",
    "scopeId"
  ],
  "additionalProperties": false
}
