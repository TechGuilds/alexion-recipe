{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": { "const": 1 },
    "phases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1, "pattern": "\\S" },
          "title": { "type": "string", "minLength": 1, "pattern": "\\S" },
          "tasks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string", "minLength": 1, "pattern": "\\S" },
                "title": { "type": "string", "minLength": 1, "pattern": "\\S" },
                "dependsOn": { "type": "array", "items": { "type": "string", "minLength": 1, "pattern": "\\S" }, "uniqueItems": true },
                "optionalDependsOn": { "type": "array", "items": { "type": "string", "minLength": 1, "pattern": "\\S" }, "uniqueItems": true },
                "agent": { "type": "string", "minLength": 1, "pattern": "\\S" }
              },
              "required": ["id", "title", "dependsOn"],
              "additionalProperties": false
            },
            "minItems": 1
          }
        },
        "required": ["id", "title", "tasks"],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": ["version", "phases"],
  "additionalProperties": false
}
