{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "workflow": {
      "$ref": "workflow.schema.json"
    },
    "scopeId": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "results": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "uniqueItems": true
    },
    "decisions": {
      "type": "array",
      "items": {
        "$ref": "decision.schema.json"
      }
    },
    "requiredTaskIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "uniqueItems": true
    },
    "requiredEvidenceKindsByTask": {
      "type": "object",
      "properties": {},
      "description": "Optional vendor-neutral evidence kinds required for a selected task result. Each property name is a workflow task ID and each value is a non-empty unique string array."
    }
  },
  "required": [
    "workflow",
    "scopeId",
    "inputs",
    "results",
    "decisions"
  ],
  "additionalProperties": false
}
