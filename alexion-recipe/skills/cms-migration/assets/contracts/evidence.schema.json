{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "role": {
      "enum": [
        "source",
        "target"
      ]
    },
    "scopeId": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "entityId": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Optional stable inventory entity ID when this artifact proves one entity's result within a grouped workflow task."
    },
    "provenance": {
      "type": "object",
      "properties": {
        "producer": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "path",
              "sha256"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "required": [
        "producer",
        "version",
        "sha256",
        "inputs"
      ],
      "additionalProperties": false
    },
    "observation": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "passed": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "passed"
        ],
        "additionalProperties": false
      }
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "uniqueItems": true
    }
  },
  "required": [
    "kind",
    "path",
    "role",
    "scopeId",
    "provenance",
    "observation",
    "checks",
    "unresolved"
  ],
  "additionalProperties": false
}
