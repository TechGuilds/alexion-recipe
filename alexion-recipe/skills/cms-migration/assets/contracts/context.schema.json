{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "artifactId": {
      "type": "string",
      "pattern": "^[a-f\\d]{24}$"
    },
    "scopeId": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "updatedAt": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "migration": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "mode": {
          "enum": [
            "full-migration",
            "discovery-only"
          ]
        },
        "discovery": {
          "type": "object",
          "properties": {
            "sides": {
              "type": "array",
              "items": {
                "enum": [
                  "source",
                  "target"
                ]
              },
              "uniqueItems": true,
              "minItems": 1
            },
            "surfaces": {
              "type": "array",
              "items": {
                "enum": [
                  "content",
                  "code"
                ]
              },
              "uniqueItems": true,
              "minItems": 1
            }
          },
          "additionalProperties": false,
          "required": [
            "sides",
            "surfaces"
          ]
        }
      },
      "additionalProperties": false
    },
    "roots": {
      "type": "object",
      "properties": {
        "migration": {
          "type": "string",
          "minLength": 1,
          "pattern": "^/"
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "pattern": "^/"
        },
        "target": {
          "type": "string",
          "minLength": 1,
          "pattern": "^/"
        },
        "app": {
          "type": "string",
          "minLength": 1,
          "pattern": "^/"
        },
        "serialization": {
          "type": "string",
          "minLength": 1,
          "pattern": "^/"
        }
      },
      "additionalProperties": false
    },
    "connectors": {
      "type": "object",
      "properties": {
        "sourceContent": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "type": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "required": [
            "id",
            "name",
            "type"
          ],
          "additionalProperties": false
        },
        "targetContent": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "type": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "required": [
            "id",
            "name",
            "type"
          ],
          "additionalProperties": false
        },
        "sourceCode": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "type": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "required": [
            "id",
            "name",
            "type"
          ],
          "additionalProperties": false
        },
        "targetCode": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "type": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "required": [
            "id",
            "name",
            "type"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "site": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "languages": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "uniqueItems": true
            },
            "primaryLanguage": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "additionalProperties": false
        },
        "code": {
          "type": "object",
          "properties": {
            "mode": {
              "enum": [
                "connector",
                "git-url",
                "upload"
              ]
            },
            "repoName": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "gitUrl": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "branch": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "revision": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "upload": {
              "type": "object",
              "properties": {
                "archivePath": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^/"
                },
                "filename": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "sizeBytes": {
                  "type": "number"
                },
                "uploadedAt": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "extractedTo": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^/"
                }
              },
              "additionalProperties": false,
              "required": [
                "archivePath"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "properties": {
        "appName": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "sdkVersion": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "code": {
          "type": "object",
          "properties": {
            "repoName": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "branch": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "setup": {
      "type": "object",
      "properties": {
        "initMode": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "initializedAt": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "version"
  ],
  "additionalProperties": false
}
